// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ZAYTRIX backend security models (SEC-BACKEND + SEC2-AUTH).
// - User: registered dashboard user (email + bcrypt passwordHash + optional TOTP)
// - ApiKey: per-exchange encrypted API credentials (AES-256-GCM ciphertexts)
// - AuditLog: immutable trail of security-sensitive actions (login, key ops, trades)
// - EmailVerificationToken: one-time tokens proving email ownership (SEC2-AUTH)
// - Session: server-side session tracking for revocation / "logout others" (SEC2-AUTH)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  passwordHash         String
  displayName          String
  twoFactorEnabled     Boolean  @default(false)
  totpSecret           String? // legacy field (SEC-BACKEND) — kept for backward compat; SEC2-AUTH uses twoFactorSecret (encrypted)
  // SEC2-AUTH additions:
  emailVerified        DateTime? // set when user confirms email via token
  twoFactorSecret      String? // AES-256-GCM encrypted TOTP secret (SEC2-AUTH)
  failedLoginAttempts  Int      @default(0)
  lockedUntil          DateTime? // if set, login refused until this timestamp
  resetToken           String? // password-reset token (looked up by email)
  resetTokenExpiry     DateTime?
  oauthProvider        String? // "google" if user was created via OAuth
  oauthId              String? // provider-specific user id (e.g. Google sub)
  // SEC3-AUTH (AUTH10) additions: HaveIBeenPwned breach check results.
  // breachChecked=when the password was last checked against the breach DB.
  // breachCount=number of times the password appeared in known data dumps
  // (0 if never breached or not yet checked). The check is advisory: it warns
  // the user but does NOT block registration/login.
  breachChecked        DateTime?
  breachCount          Int      @default(0)
  // QA10 (Direksi F — tier framework): plan + role. Defaults keep existing
  // users on "free"/"user"; billing/payment integration is a future operator
  // decision — these fields are the schema foundation only.
  plan                 String   @default("free")
  role                 String   @default("user")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  sessions             Session[]
  webAuthnCredentials  WebAuthnCredential[]
  portfolioHoldings   PortfolioHolding[]
  ledgerTransactions  LedgerTransaction[]
  backtestResults     BacktestResult[]
  conversions         ConversionTransaction[]
  alerts              AlertConfig[]
  chatMessages        ChatMessage[]
  aiUsageEvents       AiUsageEvent[]
  paperAccount        PaperAccount?
  paperOrders         PaperOrder[]
  paperPositions      PaperPosition[]
}

model ApiKey {
  id                   String   @id @default(cuid())
  userId               String
  exchange             String // Binance, KuCoin, Bybit, etc.
  encryptedKey         String // AES-256-GCM encrypted API key
  encryptedSecret      String // AES-256-GCM encrypted API secret
  encryptedPassphrase  String? // for KuCoin
  label                String   @default("default")
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, label])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. "LOGIN", "LOGOUT", "REGISTER", "API_KEY_SAVE", "TRADE_EXECUTE"
  ip        String?
  userAgent String?
  metadata  String? // JSON string
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// SEC2-AUTH: one-time tokens used to verify ownership of an email address
// before treating the User as emailVerified. Tokens are cuid-based 32-byte
// strings, hashed before storage with sha256 (we store the hash, not the raw
// token — same pattern as reset tokens would use, but Prisma doesn't have a
// native hash type so we store the hex digest directly).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// SEC2-AUTH: server-side session tracking. Every successful login inserts a
// row here with the sha256 hash of the JWT (we never store the JWT itself).
// This enables: "logout other sessions", session revocation, idle-timeout
// enforcement, and a server-side kill-switch.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256(jwt) — server-side session tracking
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// SEC2-DATA: Portfolio / Ledger / Backtest / Conversion persistence.
// Previously all client-side localStorage — now synced server-side per user.
model PortfolioHolding {
  id            String   @id @default(cuid())
  userId        String
  symbol        String
  category      String   // crypto, stock, etc.
  purchasePrice Float
  quantity      Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OPT-4b: shadow Decimal columns for money/quantity fields. Existing Float
  // columns remain untouched so JS code using `parseFloat`/arithmetic on
  // `purchasePrice`/`quantity` is unaffected. Future writes SHOULD populate both
  // the Float column (for backward-compat reads) and these Decimal columns
  // (for precision-safe math). Migration is gradual: readers first dual-read,
  // then writers stop populating Float, then Float column is dropped.
  purchasePriceDec Decimal?
  quantityDec       Decimal?

  @@index([userId])
}

model LedgerTransaction {
  id            String   @id @default(cuid())
  userId        String
  timestamp     String   // ISO date string (preserves client format)
  type          String   // BUY, SELL, CONVERT, FEE, etc.
  symbol        String
  quantity      Float
  price         Float
  totalAmount   Float
  feePaidUsd    Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OPT-4b: shadow Decimal columns for money/quantity fields. Existing Float
  // columns remain untouched so JS code using `parseFloat`/arithmetic on
  // `quantity`/`price`/`totalAmount`/`feePaidUsd` is unaffected. Future writes
  // SHOULD populate both the Float column (backward-compat) and these Decimal
  // columns (precision-safe). See PortfolioHolding for migration plan.
  quantityDec       Decimal?
  priceDec          Decimal?
  totalAmountDec    Decimal?
  feePaidUsdDec     Decimal?

  // OPT-4c: shadow DateTime column for the legacy String `timestamp` field.
  // Existing String column stays untouched so JS code that parses it as an ISO
  // string is unaffected. Future writes SHOULD populate both columns: the
  // String (backward compat with client format) and this DateTime (proper
  // DB-side date queries, range scans, ordering).
  timestampDt       DateTime?

  @@index([userId])
  @@index([userId, timestamp])
}

model BacktestResult {
  id            String   @id @default(cuid())
  userId        String
  symbol        String
  strategy      String
  startDate     String
  endDate       String
  initialCapital Float
  finalCapital  Float
  totalReturn   Float
  sharpeRatio   Float?
  maxDrawdown   Float?
  winRate       Float?
  totalTrades   Int
  equityCurve   String   // JSON string of equity curve data
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OPT-4b: shadow Decimal columns for money fields. Existing Float columns
  // (`initialCapital`/`finalCapital`/`totalReturn`) remain untouched so JS
  // arithmetic on them is unaffected. `sharpeRatio`/`maxDrawdown`/`winRate`
  // are deliberately NOT shadowed — they're computed statistics, not money;
  // Float precision is acceptable for analytics ratios.
  initialCapitalDec Decimal?
  finalCapitalDec   Decimal?
  totalReturnDec    Decimal?

  // OPT-4c: shadow DateTime columns for the legacy String `startDate`/`endDate`
  // fields. Existing String columns stay untouched so JS parsing of ISO strings
  // is unaffected. Future writes SHOULD populate both columns.
  startDateDt       DateTime?
  endDateDt         DateTime?

  @@index([userId])
}

model ConversionTransaction {
  id            String   @id @default(cuid())
  userId        String
  fromSymbol    String
  fromAmount    Float
  toSymbol      String
  toAmount      Float
  rate          Float
  timestamp     String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OPT-4b: shadow Decimal columns for money fields. Existing Float columns
  // (`fromAmount`/`toAmount`/`rate`) remain untouched. Future writes should
  // populate both.
  fromAmountDec Decimal?
  toAmountDec   Decimal?
  rateDec       Decimal?

  // OPT-4c: shadow DateTime column for the legacy String `timestamp` field.
  // Future writes SHOULD populate both columns.
  timestampDt   DateTime?

  @@index([userId])
}

model AlertConfig {
  id            String   @id @default(cuid())
  userId        String
  symbol        String
  condition     String   // above, below
  targetPrice   Float
  createdAt     String
  // FIX-P1-C / NEW FEATURE: triggered-alert tracking. When the price-checker
  // detects the condition is met, these fields are set so the UI can show
  // "Triggered" status + timestamp, and toast the user.
  triggered     Boolean  @default(false)
  triggeredAt   DateTime?
  triggerPrice  Float?   // the live price when the alert fired
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OPT-4b: shadow Decimal columns for price fields. Existing Float columns
  // (`targetPrice`/`triggerPrice`) remain untouched so JS comparison/arithmetic
  // is unaffected. Future writes should populate both.
  targetPriceDec Decimal?
  triggerPriceDec Decimal?

  // OPT-4c: shadow DateTime column for the legacy String `createdAt` field.
  // NOTE: Task spec called for `@default(now())`, but SQLite forbids adding a
  // column with a non-constant default via ALTER TABLE (Prisma db push fails
  // with "Cannot add a column with non-constant default"). So the shadow is a
  // plain `DateTime?`. Future code that wants auto-population must explicitly
  // set `createdAtDt: new Date()` on inserts. Existing rows stay NULL until
  // backfilled (NULL = "not yet migrated", which is the correct signal).
  createdAtDt     DateTime?

  @@index([userId])
  @@index([triggered, createdAt])
}

// SEC3-AUTH (AUTH10): WebAuthn / passkey credentials.
// A user can register multiple passkeys (Touch ID, YubiKey, Windows Hello, etc).
// The credentialId is the unique identifier returned by the authenticator (we
// store it base64url-encoded). The publicKey is stored as base64url-encoded
// SPKI DER (the browser exports it via crypto.subtle.exportKey("spki")). The
// counter is incremented per-authentication to detect cloned authenticators.
// `name` is a user-friendly label so the user can manage "MacBook Touch ID"
// vs "YubiKey on keychain" in the security center UI.
model WebAuthnCredential {
  id              String   @id @default(cuid())
  userId          String
  credentialId    String   @unique // base64url encoded
  publicKey       String   // base64url encoded SPKI DER (ECDSA P-256 / RSA)
  counter         Int      @default(0)
  deviceType      String? // e.g. "platform" (Touch ID / Windows Hello) or "cross-platform" (USB key)
  transports      String? // JSON array string, e.g. ["internal","usb"]
  name            String? // user-friendly label (e.g. "MacBook Touch ID")
  createdAt       DateTime @default(now())
  lastUsed        DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── QA10 (Ronde #10) — model baru ────────────────────────────────────────

// QA10-E (Direksi B — AI memory): riwayat percakapan per-user untuk
// /api/ai/chat-stream — percakapan bertahan antar reload/sesi.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  content   String
  model     String? // id model jawaban (attribution)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// QA10-E: event pemakaian AI persisten (hitung kuota harian per-user).
// Usage di-memori (aiRouter.getAIUsage) tetap sumber panel live; baris ini
// bertahan lintas restart + dipakai untuk kuota harian per-user.
model AiUsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String // "chat", "chat-stream", "gemini-analyze", dst.
  provider  String // openrouter | gemini | cache | none
  model     String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// QA10-B (Direksi D — paper trading): akun virtual per-user (1:1).
model PaperAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  cashUsd     Float    @default(10000)
  startingUsd Float    @default(10000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// QA10-B: order virtual (market-only, harga live saat submit).
model PaperOrder {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  side        String // BUY | SELL
  quantity    Float
  priceUsd    Float // harga eksekusi (live saat submit)
  notionalUsd Float
  feeUsd      Float    @default(0)
  status      String   @default("FILLED")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, symbol])
}

// QA10-B: posisi agregat per simbol (qty rata-rata tertimbang).
model PaperPosition {
  id             String   @id @default(cuid())
  userId         String
  symbol         String
  quantity       Float
  avgPriceUsd    Float
  realizedPnlUsd Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// AUTH10: WebAuthn/Passkey credentials (passwordless biometric/hardware key)
