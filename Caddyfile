:81 {
        # ─────────────────────────────────────────────────────────────────────
        # SEC-12: CATATAN KEAMANAN — port :81 hanya HTTP (preview lokal).
        # UNTUK PRODUKSI: ganti blok ini menjadi konfigurasi domain dengan TLS,
        # contoh:
        #   zaytrix.example.com {
        #       reverse_proxy localhost:3000
        #   }
        # Caddy otomatis mengeluarkan sertifikat (auto-HTTPS). Tanpa TLS,
        # cookie sesi & API-key bursa lewat plaintext — JANGAN pakai :81
        # sebagai edge publik produksi.
        # ─────────────────────────────────────────────────────────────────────

        # FIX-ALL P0-8: previously `reverse_proxy localhost:{query.XTransformPort}`
        # with NO allowlist — any unauthenticated client could proxy to ANY
        # localhost port (Postgres 5432, Redis 6379, admin panels, etc.). Now we
        # only allow ports explicitly used by the ZAYTRIX stack.
        @transform_port_query {
                query XTransformPort=*
        }

        handle @transform_port_query {
                # Allow only the ZAYTRIX dev server (3000).
                # (3003 price-feed mini-service dihapus — FUNC-13: sumbernya
                # tidak pernah ada di repo.)
                @allowed_port {
                        query XTransformPort=3000
                }
                handle @allowed_port {
                        reverse_proxy localhost:3000 {
                                header_up Host {host}
                                header_up X-Forwarded-For {remote_host}
                                header_up X-Forwarded-Proto {scheme}
                                header_up X-Real-IP {remote_host}
                        }
                }

                # Any other XTransformPort value → 403 forbidden.
                handle {
                        respond "Forbidden: XTransformPort not in allowlist" 403
                }
        }

        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}
