# ============================================================================
# ZAYTRIX — Environment Variables
# ----------------------------------------------------------------------------
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# WAJIB DIISI (tanpa ini server crash saat boot / auth 500):
# ============================================================================

# Path database SQLite — RELATIF terhadap folder prisma/ (DB berada di db/custom.db)
DATABASE_URL="file:../db/custom.db"

# Secret sesi JWT (48-byte hex). Generate: openssl rand -hex 48
SESSION_SECRET=""

# Kunci enkripsi API-key vault bursa (32-byte hex, AES-256-GCM). Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# Secret CSRF protection (32-byte hex). Generate: openssl rand -hex 32
CSRF_SECRET=""

# ============================================================================-
# OPSIONAL — AI (tanpa ini semua endpoint AI mengembalikan fallback jujur)
# UTAMA: isi OPENROUTER_API_KEY — Gemini di bawah hanya fallback opsional
#
# 9router (LOKAL): Jika 9router berjalan di localhost:20128 (default),
#   AI otomatis mendeteksi dan memprioritaskan model FREE dari 9router
#   (cepat, tanpa biaya, tanpa API key). Set NINEROUTER_ENABLED=false
#   untuk menonaktifkan dan hanya pakai OpenRouter cloud.
# ============================================================================

# Kunci Gemini dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenRouter — provider AI utama (https://openrouter.ai/keys) — CLOUD, tidak
# butuh server/proxy lokal. Otomatis fallback jika 9router tidak tersedia.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="z-ai/glm-4.5-air"
OPENROUTER_FALLBACK_MODELS="meta-llama/llama-3.3-70b-instruct,google/gemma-3-27b-it"
OPENROUTER_TIMEOUT_MS="30000"

# 9router — provider AI lokal GRATIS (otomatis terdeteksi).
# Jika 9router berjalan di localhost:20128, model free akan diprioritaskan.
# Set NINEROUTER_ENABLED=false jika ingin pakai OpenRouter cloud saja.
NINEROUTER_ENABLED="true"
# Endpoint 9router (default: localhost:20128/v1, OpenRouter-compatible)
NINEROUTER_ENDPOINT="http://localhost:20128/v1"
# Model free 9router (kosong = auto-detect dari /v1/models).
# Format: dipisah koma, contoh: kc/openrouter/free,openrouter/openrouter/free
NINEROUTER_FREE_MODELS=""

# ============================================================================
# OPSIONAL — OAuth Google (tanpa ini tombol Google login menampilkan pesan
# "belum dikonfigurasi" alih-alih 503 mentah)
# ============================================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ============================================================================
# OPSIONAL — SMTP (verifikasi email & reset password).
# Tanpa SMTP dan tanpa EMAIL_DEV_MODE, email tidak terkirim (fail-safe).
# Saat development: EMAIL_DEV_MODE=true mencetak link verifikasi ke log server.
# ============================================================================

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@zaytrix.local"
EMAIL_DEV_MODE="false"

# ============================================================================
# OPSIONAL — Lainnya
# ============================================================================

# Origin utama aplikasi (CORS allowlist, link email, OAuth callback)
APP_URL="http://localhost:3000"

# Batas notional maksimum order real per request (USD). Default 50000.
MAX_ORDER_NOTIONAL_USD="50000"

# Sentry error tracking (opsional)
SENTRY_DSN=""

# Port server (default 3000)
# PORT="3000"

# Email tujuan alert ops (opsional)
# ALERT_EMAIL=""
